  "scripts": {
    "dev": "next dev",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "start:3001": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify-v6-all.ts",
    "test:verify": "tsx scripts/verify-v6-all.ts",
    "test:soak": "tsx tools/soak-replay.ts",
    "test:py": "py -m pytest -v",
    "test:gesture": "tsx tests/gesture-robustness.test.ts",
    "test:challenger:1": "tsx tests/adversarial-challenger-1.ts",
    "test:challenger:2": "tsx tests/adversarial-challenger-2.test.ts",
    "test:global": "tsx tests/global-v4-adversarial.test.ts",
    "calibrate": "tsx scripts/fit-v6-calibration.ts",
    "twin": "py -m steadygate.twin --port 8765",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed-runner.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@mediapipe/tasks-vision": "^1.0.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
