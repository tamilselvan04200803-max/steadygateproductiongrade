# SteadyGate Environment Configuration
# Copy this file to .env and fill in the values below.

# API Security
# Generate with: openssl rand -hex 32   (>= 32 hex characters required for HMAC-SHA256)
STEADYGATE_API_SECRET=<your-32-hex-character-secret>

# Host allowlist (comma-separated) — e.g. localhost, steadi-gate.local
ALLOWED_HOSTS=localhost,steadi-gate.local

# Admin authentication
STEADYGATE_ADMIN_TOKEN=steadygate-v6-local-admin-token
STEADYGATE_REQUIRE_ADMIN_TOKEN=1

# Session cookie (set securely by /api/auth/login)
# httpOnly SameSite=Strict cookie "sessionId.hmac" is set by the login route

# Actuation ticketing
# Tickets are single-use, 2-second TTL, HMAC-signed

# DPDP Consent
# Consent must be granted (consentGranted===true) before /api/enrol POST